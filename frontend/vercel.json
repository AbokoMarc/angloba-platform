{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://angloba-platform.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://angloba-platform.onrender.com/uploads/:path*" },
    { "source": "/seed-audio/:path*", "destination": "https://angloba-platform.onrender.com/seed-audio/:path*" },
    { "source": "/seed-images/:path*", "destination": "https://angloba-platform.onrender.com/seed-images/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
