# ── Serveur ─────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5500

# ── Authentification ────────────────────────────────────
# Générez avec : openssl rand -hex 32
JWT_SECRET=change-me-please

# ── Compte Super Admin (créé automatiquement au 1er démarrage) ──
# Le super admin EST le professeur titulaire : il a tous les droits
# (gestion des profs, des autres admins, des cours, de l'apparence)
# et apparaît aussi comme professeur dans l'espace Professeur.
SUPERADMIN_NAME=Ton Nom
SUPERADMIN_EMAIL=admin@englishacademy.cm
SUPERADMIN_PASSWORD=change-me-please

# ── Base de données Turso (libSQL) ──────────────────────
# Si non définis, le serveur retombe automatiquement sur un fichier
# SQLite local (backend/data/angloba.sqlite) — aucun compte Turso
# requis pour développer en local.
#
# Pour la prod (5 min, gratuit) :
#   curl -sSfL https://get.tur.so/install.sh | bash
#   turso db create angloba
#   turso db show angloba --url
#   turso db tokens create angloba
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── IA — Speaking Lab / corrections assistées ───────────
# Choisis le fournisseur : "gemini" (palier gratuit réel, sans carte
# bancaire, sur aistudio.google.com) ou "anthropic" (Claude, payant dès
# la 1ère requête mais plus fiable sur les réponses JSON strictes).
# Tu peux basculer de l'un à l'autre à tout moment en changeant juste
# cette ligne — rien d'autre à modifier dans le code.
AI_PROVIDER=gemini

# Si AI_PROVIDER=gemini : clé depuis https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Si AI_PROVIDER=anthropic : clé depuis https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Sans clé valide pour le provider choisi, le Speaking Lab et l'aide à la
# correction ne fonctionnent pas — le reste de la plateforme continue de
# fonctionner normalement.

# ── Fichiers audio ───────────────────────────────────────
# Dossier local pour les audios uploadés par prof/admin (MVP).
# ⚠️ Sur Render/Railway (plan gratuit), le disque est éphémère :
# les fichiers uploadés sont perdus au redéploiement. Pour la prod,
# branchez un stockage objet persistant (Cloudflare R2, Backblaze B2,
# S3...) et changez UPLOAD_STRATEGY à "remote" + configurez l'URL de
# base ci-dessous. En "local", tout reste sur le disque du serveur.
UPLOAD_STRATEGY=local
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# ── Abonnement & paiement (NotchPay) ────────────────────
# NotchPay couvre Orange Money, MTN Mobile Money ET Visa/Mastercard en UNE
# seule integration : l'eleve choisit sa methode sur la page de paiement
# hebergee par NotchPay (redirection).
# Créer un compte : https://business.notchpay.co
NOTCHPAY_PUBLIC_KEY=

# URL du frontend, necessaire pour rediriger l'eleve apres paiement.
PUBLIC_APP_URL=http://localhost:5500

# Prix de l'abonnement mensuel et devise (XAF = Franc CFA, zone Cameroun/CEMAC)
PAYMENT_MONTHLY_PRICE=5000
PAYMENT_CURRENCY=XAF

# ── Notifications Push (double sens élève <-> admin/système) ───
# Genere UNE FOIS avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Secret partagé pour protéger /api/cron/check-inactifs (appelée par un
# service externe type cron-job.org, sans JWT). Génère une chaîne aléatoire
# et mets EXACTEMENT la même dans l'URL du cron : .../check-inactifs?secret=...
CRON_SECRET=change-me-please

# ── Seuils de progression ────────────────────────────────
# Score minimum (%) aux exercices d'une semaine pour pouvoir avancer.
EXERCISE_PASS_THRESHOLD=60
# Score minimum (/100) qu'une composition doit obtenir (prof OU IA) pour
# debloquer la semaine suivante quand une composition y est rattachee.
COMPOSITION_PASS_THRESHOLD=50
# Score minimum (/100) a partir duquel l'IA valide AUTOMATIQUEMENT une
# composition quand l'ELEVE demande lui-meme une correction IA immediate
# (legerement plus exigeant que la barre de validation prof, par prudence).
AI_AUTO_PASS_THRESHOLD=65
